# PostgreSQL в Neon или Supabase: приватная строка подключения с SSL.
# Для запуска сайта заполните DATABASE_URL в .env.local или настройках хостинга.
# Supabase: локально direct/session pooler, для serverless — transaction pooler.
# Импорт Supabase читает DATABASE_URL отдельно из игнорируемого .env.supabase.local.
# Supabase: используйте sslmode=verify-full; sslrootcert — абсолютный путь к CA при необходимости.
# URI и пароль доступны только серверу. Параметры SSL описаны в docs/DEPLOYMENT.md.
# Пустое значение включает SQLite.
DATABASE_URL=

# Учебный доступ через выбор роли для подготовленных синтетических аккаунтов.
# Для базы обычных пользователей задайте false.
STUDYHUB_DEMO_MODE=true

# Точный адрес сайта без пути, например http://localhost:3000.
# Пустое значение допускается только при доступе через localhost.
STUDYHUB_ORIGIN=

# Используется только при пустом DATABASE_URL.
STUDYHUB_DATA_DIR=../studyhub-data/demo
