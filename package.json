{
  "name": "db-dt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "demo:seed": "node --env-file-if-exists=.env.local scripts/seed-demo.mjs",
    "demo:setup": "node scripts/setup-demo.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-sqlite-to-postgres.mjs",
    "db:migrate:academic": "node scripts/migrate-academic.mjs",
    "db:academic:migrate": "node scripts/migrate-academic-data.mjs",
    "db:academic:seed": "node scripts/seed-academic.mjs",
    "test": "npm run test:academic && node tests/run-api.mjs",
    "test:academic": "node --test tests/academic-data-migration.test.mjs tests/academic-data.test.mjs tests/academic-cli.test.mjs tests/academic-seed-backend.test.mjs tests/academic-import.test.mjs",
    "test:postgres": "node tests/run-postgres.mjs --qa",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "typescript": "^5"
  }
}
