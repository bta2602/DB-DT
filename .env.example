# Облачная база Neon: приватная pooled-строка подключения с SSL.
# Заполните в .env.local; на Vercel DATABASE_URL обязателен.
# Пустое значение включает SQLite только при локальном запуске.
DATABASE_URL=

# Учебный доступ через выбор роли для подготовленных синтетических аккаунтов.
# Для базы обычных пользователей задайте false.
STUDYHUB_DEMO_MODE=true

# Точный адрес сайта без пути: HTTPS production-домен на Vercel.
# Локально можно указать http://localhost:3000 или http://127.0.0.1:3000.
# Пустое значение допускается только при доступе через localhost.
STUDYHUB_ORIGIN=

# Используется только при пустом DATABASE_URL. В облаке этот каталог не нужен.
STUDYHUB_DATA_DIR=../studyhub-data/demo
